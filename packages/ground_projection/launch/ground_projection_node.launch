<launch>
  <arg name="veh" doc="Name of vehicle. ex: megaman"/>
  <arg name="param_file_name" default="default" doc="Specify a param file. ex:megaman." />
    <arg name="camera_topic" default="camera_node" doc="Camera topic prefix (without vehicle namespace)"/>

    <arg name="pkg_name" value="ground_projection"/>
    <arg name="node_name" default="ground_projection_node"/>

    <group ns="$(arg veh)">
        <node name="$(arg node_name)" pkg="$(arg pkg_name)" type="$(arg node_name).py" output="screen">
            <rosparam command="load" file="$(find ground_projection)/config/$(arg node_name)/$(arg param_file_name).yaml"/>
            <remap from="~camera_info" to="$(arg camera_topic)/camera_info"/>
            <remap from="~lineseglist_in" to="line_detector_node/segment_list"/>
        </node>
    </group>
</launch>
