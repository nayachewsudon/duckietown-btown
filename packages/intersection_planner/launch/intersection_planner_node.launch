<launch>
    <arg name="veh" doc="Name of vehicle. ex: duckiebot123"/>
    <arg name="pkg_name" value="intersection_planner"/>
    <arg name="node_name" default="intersection_planner_node"/>

    <group ns="$(arg veh)">
        <node name="$(arg node_name)" pkg="$(arg pkg_name)" type="$(arg node_name).py" output="screen" required="true"/>
    </group>
</launch>
